{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SemperSupra/model-artifact-foundry/schemas/benchmark-source-declaration.schema.json",
  "title": "Model Artifact Foundry Benchmark Source Declaration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "logical_id", "artifact_kind", "materialization_mode", "components", "promotion_policy"],
  "properties": {
    "schema_version": {"const": 1},
    "logical_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$", "minLength": 3},
    "artifact_kind": {"enum": ["dataset", "benchmark", "benchmark-overlay", "synthetic-generator"]},
    "materialization_mode": {"enum": ["mirror", "upstream-hydrate", "manifest-only", "composite"]},
    "croissant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator"],
      "properties": {
        "locator": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "exact_revision": {"type": "string", "minLength": 1}
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role", "distribution", "source", "license"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "role": {"enum": ["images", "annotations", "labels", "captions", "evaluator", "index", "generator", "metadata", "other"]},
          "distribution": {"enum": ["mirror", "upstream-hydrate", "manifest-only"]},
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider", "locator"],
            "properties": {
              "provider": {"enum": ["github", "huggingface", "https", "project"]},
              "locator": {"type": "string", "minLength": 1},
              "exact_revision": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          },
          "license": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "redistribution_permitted", "evidence"],
            "properties": {
              "status": {"enum": ["verified", "unresolved"]},
              "spdx_id": {"type": ["string", "null"]},
              "redistribution_permitted": {"type": "boolean"},
              "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            }
          },
          "sample_identity": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "split_field": {"type": "string", "minLength": 1},
              "sample_id_field": {"type": "string", "minLength": 1},
              "source_hash_field": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["logical_id", "identity"],
        "properties": {
          "logical_id": {"type": "string", "minLength": 3},
          "identity": {"type": "string", "minLength": 7},
          "relationship": {"type": "string", "minLength": 1}
        }
      }
    },
    "validator_profile": {"type": "string", "minLength": 1},
    "promotion_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {"mode": {"const": "review-required"}}
    }
  }
}
