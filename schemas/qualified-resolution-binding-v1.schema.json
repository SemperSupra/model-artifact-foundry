{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SemperSupra/model-artifact-foundry/schemas/qualified-resolution-binding-v1.schema.json",
  "title": "Model Artifact Foundry Qualified Resolution Binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resolution", "resolution_key", "qualification", "selection", "binding_digest"],
  "properties": {
    "schema_version": {"const": 1},
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_digest", "target_profile_id", "environment_digest", "runtime"],
      "properties": {
        "request_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "target_profile_id": {"type": "string", "minLength": 1},
        "environment_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "toolchain_digest", "config_digest"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "toolchain_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "config_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        }
      }
    },
    "resolution_key": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_key", "record_digest"],
      "properties": {
        "subject_key": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "record_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "representation", "runtime", "target_profile_id"],
      "properties": {
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "repository", "source_revision"],
          "properties": {
            "provider": {"type": "string", "minLength": 1},
            "repository": {"type": "string", "minLength": 1},
            "source_revision": {"type": "string", "minLength": 1}
          }
        },
        "representation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "variant", "quantization"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "variant": {"type": "string", "minLength": 1},
            "quantization": {"type": "string", "minLength": 1}
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {"id": {"type": "string", "minLength": 1}}
        },
        "target_profile_id": {"type": "string", "minLength": 1}
      }
    },
    "binding_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
