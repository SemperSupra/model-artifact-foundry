{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SemperSupra/model-artifact-foundry/schemas/local-acquisition-record.schema.json",
  "title": "Model Artifact Foundry Local Acquisition Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "logical_id", "artifact_identity", "upstream", "access", "files", "redistribution"],
  "properties": {
    "schema_version": {"const": 1},
    "logical_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$"},
    "artifact_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "digest"],
      "properties": {
        "kind": {"const": "content-manifest"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "repository", "exact_revision"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "minLength": 1},
        "exact_revision": {"type": "string", "minLength": 7}
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["user-accepted-gated", "authenticated-gated", "restricted"]}
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size_bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:\\\\).+"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "redistribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_publish_allowed"],
      "properties": {
        "public_publish_allowed": {"const": false}
      }
    }
  }
}
